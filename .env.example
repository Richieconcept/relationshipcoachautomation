PORT=3000

FLOW_URL=https://labs.google/fx/tools/flow
FLOW_PROJECT_URL=

HEADLESS=false
CHROMIUM_SANDBOX=true

FLOW_ACCOUNT=
FLOW_ACCOUNTS=default,account-2
BROWSER_PROFILES_DIR=./browser-profiles

DOWNLOAD_DIR=./downloads/videos
UPLOAD_DIR=./uploads/references
SCREENSHOT_DIR=./screenshots
BROWSER_PROFILE_DIR=./browser-profile
LOG_FILE=./logs/app.log

GENERATION_TIMEOUT_MS=900000
FLOW_GENERATION_RETRIES=20
FLOW_GENERATION_RETRY_DELAY_MS=60000
POLL_INTERVAL_MS=5000

FLOW_DEFAULT_ASPECT_RATIO=9:16
FLOW_DEFAULT_PROJECT=
FLOW_DEFAULT_MODEL=Omni 1.1 Flash
FLOW_DEFAULT_RESOLUTION=360p
FLOW_DEFAULT_DURATION=10s
FLOW_DEFAULT_OUTPUT_COUNT=1

# Multi-scene projects
PROJECT_DOWNLOAD_DIR=./downloads/projects
MAX_SCENE_RETRIES=2
# Retry temporary scene failures until success (MAX_SCENE_RETRIES applies only when false).
RETRY_SCENE_UNTIL_SUCCESS=true
# After this many failed downloads of the old result, regenerate the scene.
MAX_DOWNLOAD_RECOVERY_ATTEMPTS=3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
NORMALIZE_VIDEO=true
OUTPUT_VIDEO_CODEC=libx264
OUTPUT_AUDIO_CODEC=aac
OUTPUT_FPS=30

# Script mode: each scene uses the shortest of these Flow clip lengths that fits its words
FLOW_DURATIONS=4s,6s,8s,10s
SCRIPT_WORDS_PER_SECOND=2.5
# Seconds left unspoken in every clip: words per clip = (length - 1.5) x 2.5 -> 4s:6, 6s:11, 8s:16, 10s:21
SCRIPT_SPEECH_MARGIN_SECONDS=1.5
# Cut the silence after the presenter's last word (keeping TRIM_TAIL_SECONDS) so scenes join without dead air
TRIM_TRAILING_SILENCE=true
TRIM_TAIL_SECONDS=0.4
# {text} is replaced by the scene's words
SCRIPT_SCENE_TEMPLATE=The presenter looks directly into the camera and says, word for word, exactly this and nothing else: "{text}"

# Brand assets (presenter.png, logo.png, music.mp3), uploaded from the Brand panel
BRAND_DIR=./brand

# Editor: logo, background music and captions, added after the scenes are joined
# top-right | top-left | bottom-right | bottom-left
LOGO_POSITION=top-right
LOGO_WIDTH_PERCENT=16
LOGO_MARGIN_PX=48
LOGO_OPACITY=0.9
# Relative to the voice (music is loudness-levelled first): 0.18 is about 15 dB under the presenter
MUSIC_VOLUME=0.18
MUSIC_DUCKING=true
MUSIC_FADE_SECONDS=1.5
# Any installed font; or put .ttf/.otf files in brand/fonts and use their name
CAPTION_FONT=Bangers
# 0 = automatic (124 on 1080x1920)
CAPTION_FONT_SIZE=0
CAPTION_COLOR="#FFFFFF"
CAPTION_HIGHLIGHT_COLOR="#66FF66"
CAPTION_ANIMATION=true
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=true
# Distance from the bottom edge, percent of height (keeps captions above TikTok/Reels buttons)
CAPTION_BOTTOM_PERCENT=20
SMART_PACING=true
LONG_PAUSE_SECONDS=0.75
KEPT_PAUSE_SECONDS=0.30
SPEECH_LEAD_SECONDS=0.12
SPEECH_TAIL_SECONDS=0.18
CUT_BLEND_SECONDS=0.08
MATCH_SCENE_PACE=true
MAX_SCENE_SPEED=1.20
SCENE_PACE_TOLERANCE=0.10

# Cloudinary (final video hosting) - keep secret, never commit
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flow-social-automation

# Buffer (publishing) - keep secret, never commit
BUFFER_API_KEY=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
# addToQueue | shareNow | shareNext | draft
BUFFER_POST_MODE=addToQueue
# auto | reel | post
BUFFER_FACEBOOK_POST_TYPE=auto
# 22 = People & Blogs (Buffer requires a YouTube category)
BUFFER_YOUTUBE_CATEGORY_ID=22
# public | unlisted | private
BUFFER_YOUTUBE_PRIVACY=public
BUFFER_YOUTUBE_MADE_FOR_KIDS=false
# Flow videos are AI-generated; tell TikTok and YouTube so
BUFFER_DISCLOSE_AI_GENERATED=true

# AI planner: server-side credentials only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hosted controls are public when enabled; local defaults stay loopback-only.
ALLOW_REMOTE_CONTROLS=false
TRUST_PROXY=false

# Optional hosted Google session: private authenticated state, never put a real value in Git.
FLOW_SESSION_STATE=
# Private setup checks only; this is not a dashboard login.
CLOUD_SETUP_TOKEN=
CLOSE_BROWSER_AFTER_GENERATION=false

# Preferred manual destinations; does not enable scheduling or submit posts.
DEFAULT_PUBLISH_PLATFORMS=facebook,youtube
